# DoseWise backend configuration
# Copy this file to .env and fill in your own values. Never commit .env.

# --- Auth ---
# Secret used to sign login tokens (JWT). Use a long random string in production.
# If unset, a secret is generated once and stored in app/storage/.jwt_secret.
JWT_SECRET=
# How long a login session lasts, in hours (default 72)
JWT_TTL_HOURS=72

# --- Frontend origin(s) allowed to call this API (comma-separated) ---
CORS_ORIGINS=http://localhost:3000

# --- AI summaries (optional) ---
# Groq API key (used first if set; model via GROQ_MODEL, default llama-3.3-70b-versatile)
GROQ_API_KEY=
# Google Gemini API key (used if Groq is not configured). Without either,
# caregiver summaries fall back to a rule-based text — the app works fine without an LLM.
GEMINI_API_KEY=
# Max seconds to wait for the LLM before falling back (default 20)
LLM_TIMEOUT_SECONDS=20

# --- Email alerts (optional) ---
# If all of these are set, DoseWise emails the caregiver about missed doses
# and abnormal vitals. For Gmail, use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CAREGIVER_EMAIL=
